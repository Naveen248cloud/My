rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- VALIDATION HELPERS ---
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 240)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPost(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             (!('authorPhotoUrl' in data) || (data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 500)) &&
             data.postType in ['TEXT', 'IMAGE', 'VIDEO', 'SONG', 'FILE', 'LINK'] &&
             data.visibility in ['PUBLIC', 'PRIVATE'] &&
             data.caption is string && data.caption.size() <= 1000 &&
             (!('textBgHex' in data) || (data.textBgHex is string && data.textBgHex.size() >= 4 && data.textBgHex.size() <= 9)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 180)) &&
             (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 240)) &&
             (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 1500)) &&
             (!('localUri' in data) || (data.localUri is string && data.localUri.size() <= 1500)) &&
             (!('mediaBase64' in data) || (data.mediaBase64 is string && data.mediaBase64.size() <= 450000)) &&
             (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 240)) &&
             (!('mimeType' in data) || (data.mimeType is string && data.mimeType.size() <= 120)) &&
             (!('fileSizeBytes' in data) || (data.fileSizeBytes is int && data.fileSizeBytes >= 0)) &&
             (!('durationMs' in data) || (data.durationMs is int && data.durationMs >= 0)) &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.commentsCount is int && data.commentsCount >= 0 &&
             data.sharesCount is int && data.sharesCount >= 0 &&
             data.viewsCount is int && data.viewsCount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidComment(data) {
      return data.postId is string && data.postId.size() >= 1 && data.postId.size() <= 128 &&
             data.postVisibility == 'PUBLIC' &&
             data.postOwnerId is string && data.postOwnerId.size() >= 1 && data.postOwnerId.size() <= 128 &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             (!('authorPhotoUrl' in data) || (data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 500)) &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidStory(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             (!('authorPhotoUrl' in data) || (data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 500)) &&
             data.visibility == 'PUBLIC' &&
             data.caption is string && data.caption.size() >= 1 && data.caption.size() <= 200 &&
             (!('mediaBase64' in data) || (data.mediaBase64 is string && data.mediaBase64.size() <= 450000)) &&
             data.bgHex is string && data.bgHex.size() >= 4 && data.bgHex.size() <= 9 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidUserPostRef(data) {
      return data.postId is string && data.postId.size() >= 1 && data.postId.size() <= 128 &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             (!('reaction' in data) || (data.reaction is string && data.reaction.size() >= 1 && data.reaction.size() <= 20)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidFollowRef(data) {
      return data.targetUserId is string && data.targetUserId.size() >= 1 && data.targetUserId.size() <= 128 &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             (!('targetName' in data) || (data.targetName is string && data.targetName.size() <= 80)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidNotification(data) {
      return data.recipientId is string && data.recipientId.size() >= 1 && data.recipientId.size() <= 128 &&
             data.actorId is string && data.actorId.size() >= 1 && data.actorId.size() <= 128 &&
             data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80 &&
             data.type in ['LIKE', 'COMMENT', 'FOLLOW', 'SHARE'] &&
             (!('postId' in data) || (data.postId is string && data.postId.size() <= 128)) &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 240 &&
             data.read is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // --- USER PROFILES & USER-SCOPED COLLECTIONS ---
    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'bio', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidUserProfile(incoming()) &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'bio', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;

      match /liked_posts/{postId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(postId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(postId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().postId == postId &&
                         incoming().keys().hasAll(['postId', 'userId', 'createdAt']) &&
                         incoming().keys().hasOnly(['postId', 'userId', 'reaction', 'createdAt']) &&
                         isValidUserPostRef(incoming());
        allow update: if isSignedIn() &&
                         isValidUserPostRef(incoming()) &&
                         request.auth.uid == userId &&
                         isValidId(postId) &&
                         incoming().userId == existing().userId &&
                         incoming().postId == existing().postId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['reaction']);
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(postId);
      }

      match /saved_posts/{postId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(postId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(postId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().postId == postId &&
                         incoming().keys().hasAll(['postId', 'userId', 'createdAt']) &&
                         incoming().keys().hasOnly(['postId', 'userId', 'createdAt']) &&
                         isValidUserPostRef(incoming());
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(postId);
      }

      match /following/{targetUserId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(targetUserId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(targetUserId) &&
                         targetUserId != userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().targetUserId == targetUserId &&
                         incoming().keys().hasAll(['targetUserId', 'userId', 'createdAt']) &&
                         incoming().keys().hasOnly(['targetUserId', 'targetName', 'userId', 'createdAt']) &&
                         isValidFollowRef(incoming());
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(targetUserId);
      }

      match /notifications/{notifId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(notifId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(notifId) &&
                         incoming().actorId == request.auth.uid &&
                         incoming().recipientId == userId &&
                         incoming().actorId != userId &&
                         incoming().read == false &&
                         incoming().keys().hasAll(['recipientId', 'actorId', 'actorName', 'type', 'message', 'read', 'createdAt']) &&
                         incoming().keys().hasOnly(['recipientId', 'actorId', 'actorName', 'type', 'postId', 'message', 'read', 'createdAt']) &&
                         isValidNotification(incoming());
        allow update: if isSignedIn() &&
                         isValidNotification(incoming()) &&
                         request.auth.uid == userId &&
                         isValidId(notifId) &&
                         incoming().recipientId == existing().recipientId &&
                         incoming().actorId == existing().actorId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(notifId);
      }
    }

    // --- SOCIAL POSTS & COMMENTS ---
    match /posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId) &&
                    (existing().visibility == 'PUBLIC' || existing().userId == request.auth.uid);

      allow list: if isSignedIn() &&
                     (existing().visibility == 'PUBLIC' || existing().userId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().likesCount == 0 &&
                       incoming().commentsCount == 0 &&
                       incoming().sharesCount == 0 &&
                       incoming().viewsCount == 0 &&
                       incoming().keys().hasAll(['userId', 'authorName', 'postType', 'visibility', 'caption', 'likesCount', 'commentsCount', 'sharesCount', 'viewsCount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly([
                         'userId', 'authorName', 'authorPhotoUrl', 'postType', 'visibility',
                         'caption', 'textBgHex', 'title', 'subtitle', 'mediaUrl', 'localUri', 'mediaBase64',
                         'fileName', 'mimeType', 'fileSizeBytes', 'durationMs',
                         'likesCount', 'commentsCount', 'sharesCount', 'viewsCount', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidPost(incoming());

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       isValidPost(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Owner updates editable post metadata
                         (existing().userId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'textBgHex', 'visibility', 'title', 'subtitle', 'updatedAt'])) ||
                         // Action 2: Authenticated user likes/reacts to a public post atomically with liked_posts creation
                         (existing().visibility == 'PUBLIC' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
                          incoming().likesCount == existing().likesCount + 1 &&
                          !exists(/databases/$(database)/documents/users/$(request.auth.uid)/liked_posts/$(postId)) &&
                          existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/liked_posts/$(postId))) ||
                         // Action 3: Authenticated user unlikes a public post atomically with liked_posts deletion
                         (existing().visibility == 'PUBLIC' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
                          incoming().likesCount == existing().likesCount - 1 &&
                          incoming().likesCount >= 0 &&
                          exists(/databases/$(database)/documents/users/$(request.auth.uid)/liked_posts/$(postId)) &&
                          !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/liked_posts/$(postId))) ||
                         // Action 4: Increment comment counter on public post
                         (existing().visibility == 'PUBLIC' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt']) &&
                          incoming().commentsCount == existing().commentsCount + 1) ||
                         // Action 5: Increment share counter on public post
                         (existing().visibility == 'PUBLIC' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['sharesCount', 'updatedAt']) &&
                          incoming().sharesCount == existing().sharesCount + 1) ||
                         // Action 6: Increment view counter on public post
                         (existing().visibility == 'PUBLIC' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'updatedAt']) &&
                          incoming().viewsCount == existing().viewsCount + 1)
                       );

      allow delete: if isSignedIn() && isValidId(postId) && existing().userId == request.auth.uid;

      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(commentId) &&
                      (existing().postVisibility == 'PUBLIC' || existing().userId == request.auth.uid || existing().postOwnerId == request.auth.uid);

        allow list: if isSignedIn() && isValidId(postId) &&
                       (existing().postVisibility == 'PUBLIC' || existing().userId == request.auth.uid || existing().postOwnerId == request.auth.uid);

        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().postId == postId &&
                         incoming().keys().hasAll(['postId', 'postVisibility', 'postOwnerId', 'userId', 'authorName', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['postId', 'postVisibility', 'postOwnerId', 'userId', 'authorName', 'authorPhotoUrl', 'text', 'createdAt']) &&
                         isValidComment(incoming()) &&
                         exists(/databases/$(database)/documents/posts/$(postId)) &&
                         get(/databases/$(database)/documents/posts/$(postId)).data.visibility == 'PUBLIC' &&
                         incoming().postOwnerId == get(/databases/$(database)/documents/posts/$(postId)).data.userId;

        allow update: if false;

        allow delete: if isSignedIn() && isValidId(postId) && isValidId(commentId) &&
                         (existing().userId == request.auth.uid || existing().postOwnerId == request.auth.uid);
      }
    }

    // --- STORIES ---
    match /stories/{storyId} {
      allow get: if isSignedIn() && isValidId(storyId) &&
                    (existing().visibility == 'PUBLIC' || existing().userId == request.auth.uid);

      allow list: if isSignedIn() &&
                     (existing().visibility == 'PUBLIC' || existing().userId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(storyId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'authorName', 'visibility', 'caption', 'bgHex', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'authorName', 'authorPhotoUrl', 'visibility', 'caption', 'mediaBase64', 'bgHex', 'createdAt']) &&
                       isValidStory(incoming());

      allow update: if false;

      allow delete: if isSignedIn() && isValidId(storyId) && existing().userId == request.auth.uid;
    }
  }
}
